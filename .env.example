# ==================================================
# ⚠️  ВАЖНО: Скопируйте этот файл в .env и заполните реальными значениями
# ⚠️  Файл .env НИКОГДА не коммитьте в репозиторий!
# ==================================================

# Telegram Bot API (получить через @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Aviation APIs (бесплатные тарифы)
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here
OPENSKY_API_USER=your_opensky_username_here_optional
OPENSKY_API_PASS=your_opensky_password_here_optional

# LLM Providers (альтернативы для РФ)
# OpenRouter — агрегатор 150+ моделей (доступен из РФ)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Together.ai — дешёвый инференс (доступен из РФ)
TOGETHER_API_KEY=your_together_api_key_here
# YandexGPT — официальный API от Яндекса (для РФ)
YANDEX_GPT_API_KEY=your_yandex_gpt_api_key_here
YANDEX_CATALOG_ID=your_yandex_catalog_id_here

# Redis кэширование (опционально)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Настройки приложения
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=300
DEBUG=True